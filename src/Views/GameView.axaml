<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OllamaNetGB.Views"
    xmlns:models="using:OllamaNetGB.Models"
    x:Class="OllamaNetGB.Views.GameView"
    x:DataType="vm:GameViewModel"
    x:CompileBindings="True"
    Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Styles>
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono,Menlo,DejaVu Sans Mono,monospace"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Toolbar -->
    <Border Grid.Row="0" Padding="12,8"
            Background="{DynamicResource AppSurfaceBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <Button Grid.Column="0" Content="▶ Start"
                Command="{Binding StartCommand}"
                IsEnabled="{Binding !IsRunning}"
                Classes="accent" Padding="16,6"/>

        <Button Grid.Column="1" Content="■ Stop"
                Command="{Binding StopCommand}"
                IsEnabled="{Binding IsRunning}"
                Margin="8,0,0,0" Padding="16,6"/>

        <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                   VerticalAlignment="Center" Margin="16,0,0,0"
                   Classes="mono" Opacity="0.8"/>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                    IsVisible="{Binding IsThinking}">
          <TextBlock Text="thinking" VerticalAlignment="Center" Opacity="0.8"/>
          <ProgressBar IsIndeterminate="True" Width="80" Height="6"
                       VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Split panes -->
    <Grid Grid.Row="1" ColumnDefinitions="*,6,*">

      <!-- ============ Left: Emulator ============ -->
      <Grid Grid.Column="0" Margin="12" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="EMULATOR" Classes="sectionHeader"/>

        <Border Grid.Row="1" Background="Black" CornerRadius="4" MinHeight="320">
          <Panel>
            <Image Source="{Binding CurrentFrame}"
                   Stretch="Uniform"
                   IsVisible="{Binding HasFrame}"
                   RenderOptions.BitmapInterpolationMode="None"/>

            <TextBlock Text="No frame — configure mGBA, then press Start or a button"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="300"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       IsVisible="{Binding HasNoFrame}"/>
          </Panel>
        </Border>

        <!-- Responsive controls: begin at the left edge and wrap instead of
             overflowing when the emulator pane becomes narrow. -->
        <WrapPanel Grid.Row="2"
                   Margin="0,10,0,0"
                   Orientation="Horizontal"
                   HorizontalAlignment="Stretch">
          <Grid RowDefinitions="Auto,Auto,Auto"
                ColumnDefinitions="Auto,Auto,Auto"
                Margin="4">
            <Button Grid.Row="0" Grid.Column="1" Content="▲"
                    Command="{Binding ManualTapCommand}"
                    CommandParameter="{x:Static models:GbaButton.Up}"
                    Width="48" Height="40"/>
            <Button Grid.Row="1" Grid.Column="0" Content="◀"
                    Command="{Binding ManualTapCommand}"
                    CommandParameter="{x:Static models:GbaButton.Left}"
                    Width="48" Height="40"/>
            <Button Grid.Row="1" Grid.Column="2" Content="▶"
                    Command="{Binding ManualTapCommand}"
                    CommandParameter="{x:Static models:GbaButton.Right}"
                    Width="48" Height="40"/>
            <Button Grid.Row="2" Grid.Column="1" Content="▼"
                    Command="{Binding ManualTapCommand}"
                    CommandParameter="{x:Static models:GbaButton.Down}"
                    Width="48" Height="40"/>
          </Grid>

          <Button Content="L" Command="{Binding ManualTapCommand}"
                  CommandParameter="{x:Static models:GbaButton.L}"
                  MinWidth="42" Margin="4" VerticalAlignment="Center"/>
          <Button Content="Select" Command="{Binding ManualTapCommand}"
                  CommandParameter="{x:Static models:GbaButton.Select}"
                  Margin="4" VerticalAlignment="Center"/>
          <Button Content="Start" Command="{Binding ManualTapCommand}"
                  CommandParameter="{x:Static models:GbaButton.Start}"
                  Margin="4" VerticalAlignment="Center"/>
          <Button Content="B" Command="{Binding ManualTapCommand}"
                  CommandParameter="{x:Static models:GbaButton.B}"
                  MinWidth="48" Margin="4" VerticalAlignment="Center"/>
          <Button Content="A" Command="{Binding ManualTapCommand}"
                  CommandParameter="{x:Static models:GbaButton.A}"
                  MinWidth="48" Margin="4" VerticalAlignment="Center"
                  Classes="accent"/>
          <Button Content="R" Command="{Binding ManualTapCommand}"
                  CommandParameter="{x:Static models:GbaButton.R}"
                  MinWidth="42" Margin="4" VerticalAlignment="Center"/>
        </WrapPanel>
      </Grid>

      <GridSplitter Grid.Column="1"
                    Background="{DynamicResource AppBorderBrush}"
                    ResizeDirection="Columns"/>

      <!-- ============ Right: Agent activity ============ -->
      <DockPanel Grid.Column="2" Margin="12">

        <!-- Current decision -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource AppSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,0,0,12">
          <StackPanel Spacing="6">
            <TextBlock Text="CURRENT DECISION" Classes="sectionHeader"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Background="{DynamicResource AppAccentSurfaceBrush}"
                      BorderBrush="{DynamicResource AppAccentBrush}"
                      BorderThickness="1"
                      CornerRadius="4" Padding="12,4">
                <TextBlock Text="{Binding CurrentButton}"
                           FontWeight="Bold" FontSize="16"
                           Classes="mono"/>
              </Border>
              <TextBlock Text="{Binding CurrentReasoning}"
                         TextWrapping="Wrap"
                         VerticalAlignment="Center"
                         Opacity="0.9"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <TabControl>
          <TabItem Header="Plan">
            <ScrollViewer>
              <StackPanel Spacing="10" Margin="8">
                <TextBlock Text="ACTIVE GOAL" Classes="sectionHeader"/>
                <TextBlock Text="{Binding ActiveGoal}" TextWrapping="Wrap"/>

                <TextBlock Text="CURRENT TASK" Classes="sectionHeader" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding ActiveTask}" TextWrapping="Wrap"/>

                <TextBlock Text="LAST OBSERVATION" Classes="sectionHeader" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding LastObservation}" TextWrapping="Wrap"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>

                <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                  <TextBlock Grid.Column="0" Text="Stuck score:" FontWeight="SemiBold"/>
                  <TextBlock Grid.Column="1" Text="{Binding StuckCount}" Margin="8,0,0,0"/>
                </Grid>

                <TextBlock Text="TASK QUEUE" Classes="sectionHeader" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding Tasks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AgentTaskItem">
                      <Grid ColumnDefinitions="80,*" Margin="0,3">
                        <TextBlock Grid.Column="0" Text="{Binding Status}"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Description}"
                                   TextWrapping="Wrap"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="CHANGE OBJECTIVE" Classes="sectionHeader" Margin="0,8,0,0"/>
                <TextBox Text="{Binding GoalInput}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="64"/>
                <Button Content="Apply objective"
                        Command="{Binding ApplyGoalCommand}"
                        HorizontalAlignment="Right"
                        Classes="accent"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <TabItem Header="Memory">
            <Grid RowDefinitions="Auto,*" Margin="8">
              <TextBlock Grid.Row="0" Text="{Binding MemoryStatus}"
                         Foreground="{DynamicResource AppTextSecondaryBrush}"
                         Margin="0,0,0,8" TextWrapping="Wrap"/>
              <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Memories}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MemoryDisplayItem">
                      <Border Background="{DynamicResource AppSurfaceBrush}"
                              BorderBrush="{DynamicResource AppBorderBrush}"
                              BorderThickness="1" CornerRadius="4"
                              Padding="8" Margin="0,0,0,6">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Kind}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource AppAccentBrush}"/>
                          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConfidenceText}"
                                     Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Summary}"
                                     TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </TabItem>

          <TabItem Header="History">
            <Grid RowDefinitions="Auto,*" Margin="8">
              <Button Grid.Row="0" Content="Clear"
                      Command="{Binding ClearLogCommand}"
                      HorizontalAlignment="Right"
                      FontSize="11" Padding="8,2" Margin="0,0,0,6"/>
              <ScrollViewer Grid.Row="1" Padding="4">
                <ItemsControl ItemsSource="{Binding Log}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:DecisionLogEntry">
                      <Grid ColumnDefinitions="70,80,*" Margin="4,3">
                        <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                   Classes="mono" FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ButtonText}"
                                   Classes="mono" FontSize="11"
                                   Foreground="{DynamicResource AppAccentBrush}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Reasoning}"
                                   TextWrapping="Wrap" FontSize="11" Opacity="0.85"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
