<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:OllamaNetGB.Views"
             xmlns:vm="using:OllamaNetGB.Views"
             x:Class="OllamaNetGB.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- High-contrast slate palette shared by every view. -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1118"/>
        <SolidColorBrush x:Key="AppNavigationBrush" Color="#111A24"/>
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#17222E"/>
        <SolidColorBrush x:Key="AppSurfaceRaisedBrush" Color="#213040"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#405266"/>
        <SolidColorBrush x:Key="AppTextBrush" Color="#F4F7FA"/>
        <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#C2CCD6"/>
        <SolidColorBrush x:Key="AppAccentBrush" Color="#56C8FF"/>
        <SolidColorBrush x:Key="AppAccentSurfaceBrush" Color="#174E68"/>
        <SolidColorBrush x:Key="AppDangerBrush" Color="#FFB4AB"/>
        <SolidColorBrush x:Key="AppDangerSurfaceBrush" Color="#681F27"/>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}"/>
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="{DynamicResource AppDangerBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppDangerSurfaceBrush}"/>
        </Style>
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:GameViewModel">
            <views:GameView />
        </DataTemplate>
        <DataTemplate DataType="vm:LogViewModel">
            <views:LogView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
